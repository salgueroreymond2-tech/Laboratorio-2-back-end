    {
      "name": "5. Resumen y Métricas",
      "item": [
        {
          "name": "GET Consulta de Resumen Global y por Grupo (SQL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/resumen",
              "host": ["{{base_url}}"],
              "path": ["resumen"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Resumen contains global metrics and group details\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('global');",
                  "    pm.expect(data.global).to.have.property('total_personas');",
                  "    pm.expect(data.global).to.have.property('total_grupos');",
                  "    pm.expect(data.global).to.have.property('total_gastos');",
                  "    pm.expect(data.global).to.have.property('monto_global_gastado');",
                  "    pm.expect(data).to.have.property('grupos');",
                  "    pm.expect(Array.isArray(data.grupos)).to.be.true;",
                  "    if (data.grupos.length > 0) {",
                  "        pm.expect(data.grupos[0]).to.have.property('cantidad_integrantes');",
                  "        pm.expect(data.grupos[0]).to.have.property('numero_gastos');",
                  "        pm.expect(data.grupos[0]).to.have.property('total_gastado');",
                  "        pm.expect(data.grupos[0]).to.have.property('promedio_gasto');",
                  "        pm.expect(data.grupos[0]).to.have.property('cantidad_liquidaciones');",
                  "        pm.expect(data.grupos[0]).to.have.property('monto_liquidaciones');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
